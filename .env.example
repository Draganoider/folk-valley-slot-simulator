# Copy this file to .env and fill in your values.
# .env is gitignored; .env.example is the committed template.
#
# Never paste a key into a commit, a source file, a chat message, or a URL. Code in this
# repo reads keys from .env, sends them in HTTP headers only, and redacts them from errors.

# Optional. A browser already installed on this machine for the Playwright tests, such as
# msedge or chrome, instead of the Chromium that npx playwright install downloads.
FV_PLAYWRIGHT_CHANNEL=
