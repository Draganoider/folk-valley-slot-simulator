# =============================================================================
# Git attributes
#
# This file should be the FIRST thing committed to a repository. Line endings are
# normalised at `git add` time, so adding it later needs one enormous "changed every
# line" commit that destroys `git blame`.
#
# This repository does not use Git LFS (DR-001 in docs/PLAN.md): shipped assets are
# compressed web formats committed as plain binaries, and CI's assets check fails one that
# is not a web format or is over the size budget in tools/ci/config.json.
# =============================================================================

# --- Line endings ------------------------------------------------------------
# Normalise to LF in the repository, native endings on checkout. Without this, a mixed
# Windows/macOS team gets line-ending churn on every commit.
* text=auto

*.md        text
*.txt       text
*.json      text
*.yml       text
*.yaml      text
*.xml       text
*.py        text
*.js        text
*.cjs       text
*.mjs       text
*.jsx       text
*.ts        text
*.tsx       text
*.html      text
*.css       text
*.svg       text

# Shell scripts must stay LF, or bash fails with "$'\r': command not found".
*.sh        text eol=lf

# --- Binary files ------------------------------------------------------------
# Never diffed or normalised. Only the web formats among them may be committed, and only
# under the size budget; full-size originals stay in the ignored art-source/ folder.

# Images
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.gif   binary
*.ico   binary
*.psd   binary

# Audio and video
*.ogg   binary
*.m4a   binary
*.mp3   binary
*.wav   binary
*.flac  binary
*.mp4   binary
*.webm  binary

# Fonts
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary

# Documents and archives
*.pdf   binary
*.zip   binary
*.7z    binary
