{
  "name": "folk-valley-slot-simulator",
  "version": "0.2.0",
  "private": true,
  "description": "A free, educational slot-machine simulator about bike, skate and scooter tricks and the bails that come with them. Virtual credits only.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Draganoider/folk-valley-slot-simulator.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "simulate": "tsx src/worker/node/cli.ts",
    "analyse": "tsx src/worker/node/analyse.ts",
    "analyse:panel": "tsx src/worker/node/panel-report.ts",
    "verify:long": "tsx src/worker/node/verify-long.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "pixi.js": "^8.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
